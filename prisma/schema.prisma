generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  queued
  generating
  done
  error
}

enum Modality {
  image
  video
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  passwordHash            String
  name                    String
  bio                     String    @default("")
  avatarKey               String?
  credits                 Int       @default(100)
  nsfwEnabled             Boolean   @default(false)
  nsfwAgeConfirmed        Boolean   @default(false)
  passwordResetTokenHash  String?
  passwordResetExpiresAt  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  jobs                    Job[]
  sessions                Session[]
  purchases               CreditPurchase[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Job {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        JobStatus @default(queued)
  modality      Modality
  modelId       String
  prompt        String
  aspectRatio   String
  duration      Int?
  resolution    String?
  batchId       String?
  firstFrameKey String?
  assetKey      String?
  contentType   String?
  errorMessage  String?
  creditsSpent    Int       @default(0)
  creditsRefunded Boolean   @default(false)
  progress        Int       @default(0)
  falRequestId  String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([expiresAt])
  @@index([batchId])
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model CreditPurchase {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSessionId  String   @unique
  packId           String
  credits          Int
  amountCents      Int
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}
