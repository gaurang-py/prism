generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  queued
  generating
  done
  error
}

enum Modality {
  image
  video
}

enum UserRole {
  user
  admin
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  passwordHash            String
  name                    String
  bio                     String    @default("")
  avatarKey               String?
  credits                 Int       @default(100)
  role                    UserRole  @default(user)
  nsfwEnabled             Boolean   @default(false)
  nsfwAgeConfirmed        Boolean   @default(false)
  passwordResetTokenHash  String?
  passwordResetExpiresAt  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  jobs                    Job[]
  sessions                Session[]
  purchases               CreditPurchase[]
  creditAdjustments       CreditAdjustment[] @relation("CreditAdjustments")
  adminCreditAdjustments  CreditAdjustment[] @relation("AdminCreditAdjustments")
  characters              Character[]
  boards                  Board[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Job {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        JobStatus @default(queued)
  modality      Modality
  modelId       String
  prompt        String
  aspectRatio   String
  duration      Int?
  resolution    String?
  batchId       String?
  firstFrameKey String?
  referenceKeys Json?
  characterId   String?
  character     Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  assetKey      String?
  contentType   String?
  errorMessage  String?
  creditsSpent    Int       @default(0)
  creditsRefunded Boolean   @default(false)
  progress        Int       @default(0)
  falRequestId  String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([expiresAt])
  @@index([batchId])
  @@index([characterId])
}

model Character {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  images    CharacterImage[]
  jobs      Job[]

  @@index([userId, createdAt])
}

model CharacterImage {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  key         String
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([characterId, sortOrder])
}

model Board {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model CreditPurchase {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSessionId  String   @unique
  packId           String
  credits          Int
  amountCents      Int
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

model CreditAdjustment {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("CreditAdjustments", fields: [userId], references: [id], onDelete: Cascade)
  adminId      String
  admin        User     @relation("AdminCreditAdjustments", fields: [adminId], references: [id], onDelete: Cascade)
  delta        Int
  balanceAfter Int
  reason       String   @default("")
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
}
