# Copy to .env and fill in secrets. Never commit real keys.

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://prism:prism@localhost:5432/prism"

# Used to HMAC session + password-reset tokens
AUTH_SECRET=""

# Public origin for Stripe redirects and password-reset links
APP_URL="http://127.0.0.1:43123"

# Fal.ai — jobs fail with a readable error if this is empty. Do not omit it and expect a mock.
FAL_KEY=""

# Cloudflare R2 (S3-compatible).
# Generated images/videos: prefix generations/ — expire after 7 days (docs/r2-lifecycle.json).
# Avatars: prefix avatars/ — NOT covered by that lifecycle rule.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="prism-generations"
# Usually https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=""
# Optional. If the bucket is public, the API will use this base instead of signed GETs.
# Example: https://pub-xxxxx.r2.dev
R2_PUBLIC_BASE_URL=""

# Stripe (test mode for local). Checkout fails clearly if STRIPE_SECRET_KEY is missing.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional. If unset, Checkout uses price_data from src/lib/credit-packs.ts
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_STUDIO=""
STRIPE_PRICE_PRO=""
# Optional. Not required for Checkout Sessions created on the server.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Mail for password reset. If both are empty, the reset URL is logged to the server console.
RESEND_API_KEY=""
MAIL_FROM="Prism <noreply@localhost>"
# SMTP fallback (used when RESEND_API_KEY is empty)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
